# Inputs for deploy/railway-bootstrap.sh.
# Copy to deploy/.env.railway (gitignored) and fill in. Required values must be
# non-empty; optional ones can stay blank (blank values are not set on Railway).

# ---- Optional: Railway targets ----
# Project name is used only when no project is linked yet.
# RAILWAY_PROJECT_NAME=origin-squid
# Environment defaults to the current git branch and must match railway-v<N>.
# ENVIRONMENT_NAME=railway-v164

# ---- Required: chain RPC endpoints ----
# Anything compatible with the existing dev.env values. URL must include any
# auth bits the provider expects (path-based key, query string, etc.).
RPC_ENDPOINT=
RPC_BASE_ENDPOINT=
RPC_ARBITRUM_ENDPOINT=
RPC_SONIC_ENDPOINT=
RPC_HYPEREVM_ENDPOINT=

# ---- Required: SQD portal ----
# Key for the shared SQD portal; without it squid-utils falls back to the
# rate-limited public portal.
SQD_API_KEY=

# ---- Optional: per-chain portal URL overrides ----
# Blank = squid-utils picks the portal dataset URL itself.
PORTAL_URL_ETHEREUM=
PORTAL_URL_BASE=
PORTAL_URL_SONIC=
PORTAL_URL_ARBITRUM=
PORTAL_URL_HYPEREVM=

# ---- Optional: integrations ----
# Leave blank to disable; processors that read these will skip the integration.
NOTION_SECRET=

# ---- Optional: object store ----
# Holds the database dumps (dumps/) and the RPC/Portal cache seeds (cache/).
# An empty AWS_ACCESS_KEY_ID means "no object store": processors then skip both
# the dump restore and the cache seed and sync from scratch. BUCKET_ENDPOINT is
# required for a non-AWS S3 implementation such as a Railway bucket; leave it
# blank for AWS. BUCKET_NAME defaults to `origin-squid`, BUCKET_REGION to
# `us-east-1`.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
